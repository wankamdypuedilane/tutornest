# Copy this file to .env.local and fill in your own values.
# .env.local is ignored by Git: never commit real keys.

# Supabase > Project Settings > API Keys (publishable key, starts with sb_publishable_)
NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Public base URL of the app (used in e-mails and OAuth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server-only secrets (never prefix with NEXT_PUBLIC_) ---
# Supabase > Project Settings > API Keys > Secret keys (starts with sb_secret_)
# Only needed by trusted server code that must bypass Row Level Security.
# SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY

# --- Used by the Supabase CLI (local stack), not by Next.js ---
# Put these in supabase/.env (ignored by Git) for local Google sign-in.
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
